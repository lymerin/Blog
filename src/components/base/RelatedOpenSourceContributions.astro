---
import { OPEN_SOURCE_PROJECTS } from '~/data/open-source'
import { localePath, t, type Locale } from '~/i18n'

interface Props {
  postId: string
  locale: Locale
}

const { postId, locale } = Astro.props
const related = OPEN_SOURCE_PROJECTS.flatMap((project) =>
  project.contributions
    .filter((contribution) => contribution.article === postId)
    .map((contribution) => ({ project, contribution }))
)
---

{
  related.length > 0 && (
    <section class="px-6 sm:px-8 pb-8" aria-labelledby="related-open-source-heading">
      <h2 id="related-open-source-heading" class="text-xl sm:text-2xl tracking-tight">
        {t(locale, 'article.relatedContributions')}
      </h2>
      <div class="mt-4 grid gap-3">
        {related.map(({ project, contribution }) => (
          <article class="rounded-lg border border-border/70 p-4 transition-colors hover:bg-muted/30">
            <a
              href={localePath(locale, `/open-source/${project.slug}`)}
              class="font-serif font-medium tracking-tight transition-colors hover:text-primary"
            >
              {project.name}
            </a>
            <p class="mt-1 text-sm text-muted-foreground">{contribution.title}</p>
            <a
              href={contribution.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              PR #{contribution.number}
              <span class="icon-[material-symbols--arrow-outward-rounded] size-4" />
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}

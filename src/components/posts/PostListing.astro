---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { POST_CATEGORIES, type PostCategory } from '~/lib/post-categories'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import { localePath, t, type Locale } from '~/i18n'

interface Props {
  page: Page<CollectionEntry<'posts'>>
  locale: Locale
  category?: PostCategory
}

const { page, locale, category } = Astro.props
const title = t(locale, 'posts.title')
const description = t(locale, 'posts.description')
const introduce = t(locale, 'posts.introduce')
const baseUrl = localePath(locale, category ? `/posts/category/${category}` : '/posts')
const filters = [
  { key: undefined, label: t(locale, 'posts.all'), href: localePath(locale, '/posts') },
  ...POST_CATEGORIES.map((key) => ({ key, label: t(locale, `posts.category.${key}`), href: localePath(locale, `/posts/category/${key}`) })),
]
---

<Layout {title} {description}>
  <div class="relative z-[1] py-8 pb-10 px-6 sm:px-8">
    <PageTitle {title} {introduce} />
    <nav class="mt-6 flex flex-wrap gap-2" aria-label={t(locale, 'posts.filters')} data-pagefind-ignore>
      {
        filters.map((filter) => (
          <a
            href={filter.href}
            aria-current={category === filter.key ? 'page' : undefined}
            class:list={[
              'inline-flex items-center rounded-full border px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background',
              category === filter.key
                ? 'border-foreground/20 bg-muted text-foreground'
                : 'border-border bg-background text-muted-foreground hover:bg-muted/50 hover:text-foreground',
            ]}
          >
            {filter.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-12 fade-up">
      {
        page.data.length > 0 ? (
          <List posts={page.data} type={POSTS_CONFIG.postPageConfig.type} coverLayout={POSTS_CONFIG.postPageConfig?.coverLayout} />
        ) : (
          <div class="py-12 text-center text-muted-foreground">
            <span class="icon-[material-symbols--article-outline-rounded] mx-auto mb-3 block size-8" />
            <p>{t(locale, category ? 'posts.categoryEmpty' : 'posts.empty')}</p>
          </div>
        )
      }
    </div>
    <Pagination {page} {baseUrl} {locale} />
  </div>
</Layout>

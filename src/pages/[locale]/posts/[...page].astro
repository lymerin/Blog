---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { getAllPosts } from '~/lib/data'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import { LOCALES, localePath, t, type Locale } from '~/i18n'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const paths = await Promise.all(
    LOCALES.map(async (locale) => {
      const sortedPosts = await getAllPosts(locale)
      return paginate(sortedPosts, {
        params: { locale },
        props: { locale },
        pageSize: POSTS_CONFIG.postPageConfig.size,
      })
    })
  )

  return paths.flat()
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
  locale: Locale
}

const { page, locale } = Astro.props
const title = t(locale, 'posts.title')
const description = t(locale, 'posts.description')
const introduce = t(locale, 'posts.introduce')
---

<Layout {title} {description}>
  <div class="relative z-[1] py-8 pb-10 px-6 sm:px-8">
    <PageTitle {title} {introduce} />
    <div class="mt-12 fade-up">
      {
        page.data.length > 0 ? (
          <List posts={page.data} type={POSTS_CONFIG.postPageConfig.type} coverLayout={POSTS_CONFIG.postPageConfig?.coverLayout} />
        ) : (
          <div class="py-12 text-center text-muted-foreground">
            <span class="icon-[material-symbols--article-outline-rounded] mx-auto mb-3 block size-8"></span>
            <p>{t(locale, 'posts.empty')}</p>
          </div>
        )
      }
    </div>
    <Pagination {page} baseUrl={localePath(locale, '/posts')} {locale} />
  </div>
</Layout>

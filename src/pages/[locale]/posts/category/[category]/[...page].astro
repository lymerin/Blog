---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { getAllPosts } from '~/lib/data'
import { getPostCategory, POST_CATEGORIES, type PostCategory } from '~/lib/post-categories'
import { LOCALES, type Locale } from '~/i18n'
import PostListing from '~/components/posts/PostListing.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const paths = await Promise.all(
    LOCALES.map(async (locale) => {
      const posts = await getAllPosts(locale)
      return POST_CATEGORIES.flatMap((category) =>
        paginate(
          posts.filter((post) => getPostCategory(post) === category),
          {
            params: { locale, category },
            props: { locale, category },
            pageSize: POSTS_CONFIG.postPageConfig.size,
          }
        )
      )
    })
  )
  return paths.flat()
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
  locale: Locale
  category: PostCategory
}

const { page, locale, category } = Astro.props
---

<PostListing {page} {locale} {category} />
